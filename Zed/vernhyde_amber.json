{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Vernhyde Amber",
  "author": "Vernhyde",
  "themes": [
    {
      "name": "Vernhyde Amber",
      "appearance": "dark",
      "style": {
        "background": "#0d0f11",
        "editor.background": "#0d0f11",
        "editor.gutter.background": "#0d0f11",
        "editor.subheader.background": "#111417",
        "editor.active_line.background": "#16191d",
        "editor.highlighted_line.background": "#26181c",
        "editor.line_number": "#53383d",
        "editor.active_line_number": "#e5a93d",
        "editor.indent_guide": "#26181c",
        "editor.indent_guide_active": "#53383d",
        "editor.document_highlight.read_background": "#4b2b3166",
        "editor.document_highlight.write_background": "#8f204166",
        "editor.document_highlight.bracket_background": "#e5a93d33",
        "panel.background": "#111417",
        "panel.focused_border": "#e5a93d",
        "toolbar.background": "#0d0f11",
        "tab_bar.background": "#111417",
        "tab.inactive_background": "#111417",
        "tab.active_background": "#0d0f11",
        "status_bar.background": "#0d0f11",
        "title_bar.background": "#0d0f11",
        "surface.background": "#111417",
        "elevated_surface.background": "#16191d",
        "terminal.background": "#0d0f11",
        "terminal.foreground": "#dcdcdc",
        "terminal.ansi.black": "#16191d",
        "terminal.ansi.bright_black": "#53383d",
        "terminal.ansi.red": "#d9385a",
        "terminal.ansi.bright_red": "#ff5277",
        "terminal.ansi.green": "#5f7a50",
        "terminal.ansi.bright_green": "#7fa36b",
        "terminal.ansi.yellow": "#e5a93d",
        "terminal.ansi.bright_yellow": "#fee344",
        "terminal.ansi.blue": "#c87a53",
        "terminal.ansi.bright_blue": "#e69870",
        "terminal.ansi.magenta": "#a85c72",
        "terminal.ansi.bright_magenta": "#c97a90",
        "terminal.ansi.cyan": "#5a9aa8",
        "terminal.ansi.bright_cyan": "#7ec1cf",
        "terminal.ansi.white": "#dcdcdc",
        "terminal.ansi.bright_white": "#ffe3bb",
        "border": "#3a3235",
        "border.variant": "#26181c",
        "border.focused": "#e5a93d",
        "border.selected": "#e5a93d",
        "element.background": "#16191d",
        "element.hover": "#1f2329",
        "element.active": "#4b2b31",
        "element.selected": "#4b2b31",
        "text": "#dcdcdc",
        "text.muted": "#8a8280",
        "text.placeholder": "#53383d",
        "text.accent": "#e5a93d",
        "icon": "#dcdcdc",
        "icon.muted": "#8a8280",
        "icon.accent": "#e5a93d",
        "created": "#7fa36b",
        "modified": "#e5a93d",
        "deleted": "#d9385a",
        "warning": "#ffa72e",
        "error": "#ff5277",
        "accents": [
          "#e5a93d",
          "#c87a53",
          "#7fa36b",
          "#a85c72",
          "#5a9aa8",
          "#d9385a"
        ],
        "players": [
          {
            "cursor": "#e5a93d",
            "background": "#e5a93d",
            "selection": "#4b2b3188"
          }
        ],
        "syntax": {
          "tag": { "color": "#e5a93d", "font_style": "normal" },
          "tag.delimiter": { "color": "#8a8280" },
          "attribute": { "color": "#f09654", "font_style": "italic" },
          "preproc": { "color": "#f09654", "font_style": "italic" },
          "meta": { "color": "#f09654", "font_style": "italic" },
          "text": { "color": "#dcdcdc" },
          "comment": { "color": "#8a8280", "font_style": "italic" },
          "comment.doc": { "color": "#a8845e", "font_style": "italic" },
          "keyword": { "color": "#e5a93d", "font_style": "italic" },
          "type": { "color": "#ffe3bb" },
          "type.builtin": { "color": "#ffe3bb", "font_style": "italic" },
          "constructor": { "color": "#7ec1cf" },
          "enum": { "color": "#7ec1cf" },
          "variant": { "color": "#7ec1cf" },
          "type.enum.variant": { "color": "#7ec1cf" },
          "function": { "color": "#e69870" },
          "function.method": { "color": "#e69870" },
          "function.macro": { "color": "#d9385a" },
          "string": { "color": "#7fa36b" },
          "string.escape": { "color": "#7ec1cf" },
          "string.regex": { "color": "#7ec1cf" },
          "number": { "color": "#fee344" },
          "boolean": { "color": "#fee344", "font_style": "italic" },
          "constant": { "color": "#fee344" },
          "constant.builtin": { "color": "#fee344", "font_style": "italic" },
          "variable": { "color": "#dcdcdc" },
          "variable.member": { "color": "#c87a53" },
          "variable.special": { "color": "#ff5277", "font_style": "italic" },
          "variable.parameter": { "color": "#dcdcdc", "font_style": "italic" },
          "property": { "color": "#c87a53" },
          "operator": { "color": "#e5a93d" },
          "punctuation": { "color": "#afabaa" },
          "punctuation.bracket": { "color": "#afabaa" },
          "punctuation.delimiter": { "color": "#8a8280" },
          "punctuation.special": { "color": "#e5a93d" },
          "label": { "color": "#c97a90", "font_style": "italic" },
          "lifetime": { "color": "#c97a90", "font_style": "italic" }
        }
      }
    }
  ]
}
